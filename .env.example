# ──────────────────────────────────────────────────────────────────
# Nexora – environment configuration
# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with: sh infrastructure/scripts/generate-secrets.sh
# Passwords may contain special characters (they are URL-encoded automatically). If a value
# contains #, spaces or double quotes, wrap it in single quotes: MYSQL_PASSWORD='p@ss#word'.
# Avoid $ and ' in passwords.
# MySQL keeps MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD from the FIRST start in its data volume:
# changing them here later does not change the database (see repair-db-credentials.sh).
# ──────────────────────────────────────────────────────────────────

# Database (MySQL 8.4, internal network only)
MYSQL_DATABASE=mnm
MYSQL_USER=mnm
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Redis (internal network only)
REDIS_PASSWORD=CHANGE_ME

# Signs dashboard session tokens. At least 32 random characters.
JWT_SECRET=CHANGE_ME

# Optional fixed setup code (min. 16 chars). Leave empty to print a random one
# to the backend log on startup: docker compose logs backend
SETUP_TOKEN=

# Dashboard exposure
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3000

# Session cookies: auto = Secure flag when served over HTTPS. Use "true" behind HTTPS.
COOKIE_SECURE=auto
# Proxies whose X-Forwarded-For headers the backend trusts (Express syntax).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Optional MaxMind GeoLite2 databases (approximate IP location), mounted from ./geoip
# See docs/architecture/player-profiles.md
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# OpenAPI docs at /api/docs
API_DOCS_ENABLED=true
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Optional HTTPS via Caddy (docker compose --profile https up -d)
DASHBOARD_DOMAIN=dashboard.example.com
ACME_EMAIL=

# Release of the Nexora images (ghcr.io/epicclowds/nexora/backend and /dashboard).
# Pinned on purpose: change it to update, then run "docker compose pull && docker compose up -d".
# Use the same version for the Minecraft plugins (GitHub Releases).
NEXORA_VERSION=1.0.2
