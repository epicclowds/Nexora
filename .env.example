# ──────────────────────────────────────────────────────────────────
# Minecraft Network Manager – environment configuration
# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Generate secrets with: sh infrastructure/scripts/generate-secrets.sh
# Passwords are embedded in connection URLs: use only [A-Za-z0-9] (hex is ideal).
# ──────────────────────────────────────────────────────────────────

# Database (MySQL 8.4, internal network only)
MYSQL_DATABASE=mnm
MYSQL_USER=mnm
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Redis (internal network only)
REDIS_PASSWORD=CHANGE_ME

# Signs dashboard session tokens. At least 32 random characters.
JWT_SECRET=CHANGE_ME

# Optional fixed setup code (min. 16 chars). Leave empty to print a random one
# to the backend log on startup: docker compose logs backend
SETUP_TOKEN=

# Dashboard exposure
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3000

# Session cookies: auto = Secure flag when served over HTTPS. Use "true" behind HTTPS.
COOKIE_SECURE=auto
# Proxies whose X-Forwarded-For headers the backend trusts (Express syntax).
TRUST_PROXY=loopback, linklocal, uniquelocal

# OpenAPI docs at /api/docs
API_DOCS_ENABLED=true
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Optional HTTPS via Caddy (docker compose --profile https up -d)
DASHBOARD_DOMAIN=dashboard.example.com
ACME_EMAIL=

# Container images. Point MNM_IMAGE_PREFIX at a registry to use prebuilt images
# (e.g. ghcr.io/<owner>/minecraft-network-manager); otherwise images are built locally.
MNM_IMAGE_PREFIX=mnm
MNM_VERSION=latest
