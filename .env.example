# ──────────────────────────────────────────────────────────────────
# Nexora – environment configuration (template)
#
# Docker Compose CLI: copy to .env next to docker-compose.yml and replace every
#   CHANGE_ME value. Never commit .env.
# Portainer / Arcane: enter the same variables in the stack's environment
#   variables (or load this file there) – no file on the host is needed.
# Generate secrets with: openssl rand -hex 32
#   (or, with a repository checkout: sh infrastructure/scripts/generate-secrets.sh)
#
# Passwords may contain special characters (they are URL-encoded automatically). If a value
# contains #, spaces or double quotes, wrap it in single quotes: MYSQL_PASSWORD='p@ss#word'.
# Avoid $ and ' in passwords. Random hex values (openssl rand -hex) avoid all of this.
# MySQL keeps MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD from the FIRST start in its data volume:
# changing them here later does not change the database. Keep a copy of these values.
# ──────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────

# Database (MySQL 8.4, internal network only)
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Redis (internal network only)
REDIS_PASSWORD=CHANGE_ME

# Signs dashboard session tokens. At least 32 random characters.
JWT_SECRET=CHANGE_ME

# ── Optional (the values shown are the defaults) ────────────────

# Nexora images (ghcr.io/epicclowds/nexora/backend and /dashboard).
#   latest = newest verified stable release; update with "docker compose pull && docker compose up -d"
#   1.1.0  = pinned version; change it explicitly to update
# Use the matching version of the Minecraft plugins (GitHub Releases).
NEXORA_VERSION=latest

# Database and user names (only used when the database volume is created)
MYSQL_DATABASE=mnm
MYSQL_USER=mnm

# Optional fixed setup code (min. 16 chars). Leave empty to print a random one
# to the backend log on startup (docker compose logs backend / container logs).
SETUP_TOKEN=

# Dashboard exposure. Use DASHBOARD_BIND=127.0.0.1 behind a reverse proxy on the same host.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3000

# Session cookies: auto = Secure flag when served over HTTPS. Use "true" behind HTTPS.
COOKIE_SECURE=auto
# Proxies whose X-Forwarded-For headers the backend trusts (Express syntax).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Optional MaxMind GeoLite2 databases (approximate IP location), see docs/architecture/player-profiles.md.
# GEOIP_DIR: host directory with the .mmdb files (e.g. ./geoip or /opt/nexora/geoip).
# Empty = an internal volume (GeoIP stays disabled unless files are placed in it).
GEOIP_DIR=
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# OpenAPI docs at /api/docs
API_DOCS_ENABLED=true
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Built-in HTTPS via Caddy (docker compose --profile https up -d, or COMPOSE_PROFILES=https)
DASHBOARD_DOMAIN=
ACME_EMAIL=

# Prefix of the data volume names (default minecraft-network-manager → minecraft-network-manager_mysql-data).
# Change it only for a second, independent Nexora instance on the same Docker host.
NEXORA_VOLUME_PREFIX=minecraft-network-manager
