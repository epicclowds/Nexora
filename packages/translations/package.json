{
  "name": "@mnm/translations",
  "version": "0.6.0",
  "private": true,
  "description": "Translation catalogues (dashboard + Minecraft plugins) and validation tooling.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "locales",
    "minecraft"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsc -p tsconfig.json && node scripts/validate.mjs",
    "test": "npm run validate"
  }
}
